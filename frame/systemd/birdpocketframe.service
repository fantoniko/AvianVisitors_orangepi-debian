[Unit]
Description=Publish the AvianVisitors collage to PocketFrame
Documentation=https://github.com/Twarner491/AvianVisitors
Wants=network-online.target
After=network-online.target

[Service]
# Replace User= and the paths when installing, as frame/install.sh does.
Type=oneshot
User=monalisa
WorkingDirectory=/home/monalisa/AvianVisitors/frame
# This file is intentionally outside the repository. It contains only
# POCKETFRAME_SERVER_URL and POCKETFRAME_TOKEN (KEY=value, no `export`).
EnvironmentFile=-/home/monalisa/.config/birdpocketframe.env
ExecStart=/home/monalisa/AvianVisitors/frame/.venv/bin/python /home/monalisa/AvianVisitors/frame/publish_pocketframe.py --config /home/monalisa/.birdframe/config.toml
Environment=PYTHONUNBUFFERED=1
Nice=10
TimeoutStartSec=300
