[Unit]
Description=AvianVisitors local live audio stream
After=network-online.target icecast2.service sound.target
Wants=network-online.target

[Service]
Type=simple
User=__AV_USER__
Group=__AV_USER__
SupplementaryGroups=audio
WorkingDirectory=__AV_PREFIX__
Environment=HOME=__AV_HOME__
EnvironmentFile=/etc/birdnet/birdnet.conf
ExecStart=__AV_PREFIX__/scripts/livestream.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__AV_HOME__/BirdSongs /tmp
DeviceAllow=char-alsa rw
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
