[Unit]
Description=AvianVisitors spectrogram viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__AV_USER__
Group=__AV_USER__
WorkingDirectory=__AV_PREFIX__
Environment=HOME=__AV_HOME__
EnvironmentFile=/etc/birdnet/birdnet.conf
ExecStart=__AV_PREFIX__/scripts/spectrogram.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__AV_HOME__/BirdSongs /tmp
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
