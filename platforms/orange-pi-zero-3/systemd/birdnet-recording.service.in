[Unit]
Description=AvianVisitors ALSA recording
After=sound.target
Wants=sound.target

[Service]
Type=simple
User=__AV_USER__
Group=__AV_USER__
SupplementaryGroups=audio
WorkingDirectory=__AV_PREFIX__
Environment=HOME=__AV_HOME__
EnvironmentFile=/etc/birdnet/birdnet.conf
ExecStart=__AV_PREFIX__/scripts/birdnet_recording.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__AV_HOME__/BirdSongs __AV_PREFIX__ /tmp
DeviceAllow=char-alsa rw
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
